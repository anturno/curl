# OpenCode Go (required for deployed reviews / bun run eval:live)
# https://opencode.ai/docs/go/
OPENCODE_API_KEY=
# CURL_EVAL_MOCK=1   # CI evals only — forbidden on Vercel/deployed runtime
# Accepted boolean values are exactly 1, 0, true, or false.
# Responses API model id (default: gpt-5.6-luna @ high reasoning)
# Endpoint: https://opencode.ai/zen/go/v1/responses
OPENCODE_MODEL=gpt-5.6-luna
# Positive decimal integer; default 200000, maximum 10000000.
# OPENCODE_MODEL_CONTEXT_WINDOW_TOKENS=200000
# Positive decimal integer session budgets; defaults are 1000000 / 20000.
# CURL_MAX_INPUT_TOKENS_PER_SESSION=1000000
# CURL_MAX_OUTPUT_TOKENS_PER_SESSION=20000
# Positive decimal integer; default 604800000 (7 days), maximum 31536000000.
# CURL_SESSION_TIMEOUT_MS=604800000

# GitHub App slug / @mention name (default: anturno-curl)
GITHUB_APP_SLUG=anturno-curl

# Auth mode: Connect (default) or self-managed App
# CURL_GITHUB_AUTH=connect
# CURL_GITHUB_CONNECTOR=github/anturno-curl

# Self-managed GitHub App (when CURL_GITHUB_AUTH=app)
# CURL_GITHUB_AUTH=app
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Automatic review is opt-in and disabled unless explicitly set to 1/true.
# CURL_AUTO_REVIEW=0
# Optional exact, case-insensitive owner/repo allowlist. Unset means every
# installed repository is eligible only when CURL_AUTO_REVIEW is enabled.
# CURL_AUTO_REVIEW_ALLOWLIST=acme/service,acme/web

# GitHub Check Run progress ("Curl review" in the PR Checks tab)
# Requires Checks: write on the GitHub App. Set to 0 to disable.
# CURL_CHECK_RUN=0
