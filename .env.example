# OpenCode Go (required for reviews / bun run eval:live)
# https://opencode.ai/docs/go/
OPENCODE_API_KEY=
# CURL_EVAL_MOCK=1   # CI only — forbidden on Vercel/production
# Responses API model id (default: gpt-5.6-luna @ high reasoning)
# Endpoint: https://opencode.ai/zen/go/v1/responses
OPENCODE_MODEL=gpt-5.6-luna
# OPENCODE_MODEL_CONTEXT_WINDOW_TOKENS=200000

# GitHub App slug / @mention name (default: anturno-curl)
GITHUB_APP_SLUG=anturno-curl

# Auth mode: Connect (default) or self-managed App
# CURL_GITHUB_AUTH=connect
# CURL_GITHUB_CONNECTOR=github/anturno-curl

# Self-managed GitHub App (when CURL_GITHUB_AUTH=app)
# CURL_GITHUB_AUTH=app
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Auto-review on pull_request events for every installed repository
# Fires on opened / reopened / ready_for_review (not every push)
# CURL_AUTO_REVIEW=0

# GitHub Check Run progress ("Curl review" in the PR Checks tab)
# Requires Checks: write on the GitHub App. Set to 0 to disable.
# CURL_CHECK_RUN=0
