# OpenCode Go (required for deployed reviews)
# https://opencode.ai/docs/go/
OPENCODE_API_KEY=

# Responses API model id (default: gpt-5.6-luna)
# OPENCODE_MODEL=gpt-5.6-luna

# Reasoning level: high, medium, or low (default: medium)
# OPENCODE_REASONING=medium

# GitHub App slug / @mention name (default: anturno-curl)
GITHUB_APP_SLUG=anturno-curl

# Self-managed GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
