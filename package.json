{
  "name": "anturno-curl",
  "version": "0.2.1",
  "private": true,
  "description": "Curl — open-source eve-based GitHub PR review agent",
  "license": "Apache-2.0",
  "author": "Julian De Leon",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anturno/curl.git"
  },
  "homepage": "https://github.com/anturno/curl#readme",
  "bugs": {
    "url": "https://github.com/anturno/curl/issues"
  },
  "keywords": [
    "anturno",
    "curl",
    "eve",
    "github",
    "code-review",
    "opencode"
  ],
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "deploy": "eve deploy",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "verify:config": "bun scripts/verify-config.ts",
    "eval": "CURL_EVAL_MOCK=1 eve eval --strict --junit .eve/junit.xml",
    "eval:live": "eve eval --strict --junit .eve/junit.xml",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.29",
    "@vercel/connect": "^0.6.1",
    "ai": "^7.0.38",
    "eve": "^0.29.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "25.x",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "ai": "^7.0.38"
  },
  "engines": {
    "node": "24.x",
    "bun": ">=1.2.0"
  }
}
